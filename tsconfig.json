// Base type-check config shared by tsconfig.app.json / tsconfig.game.json, run
// via `npm run typecheck`. Each page loads exactly one of app.js / game.js as
// its whole application script, and the two never coexist in a page — so they
// are checked as two separate tsc Programs (see the per-file configs). Checking
// both in one Program would falsely collide their script-mode globals
// (PVMT_CONFIG/CENTER/map/…). This base carries only compilerOptions plus the
// ambient globals; it includes no JS of its own.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "types": []
  },
  "include": ["globals.d.ts"]
}
